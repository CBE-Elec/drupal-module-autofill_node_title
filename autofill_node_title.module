<?php

/**
 * @file
 * Primary module hooks for autofill_node_title module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\node\Entity\NodeType;
use Drupal\node\NodeInterface;

/**
 * Implements hook_help().
 */
function autofill_node_title_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the autofill_node_title module.
    case 'help.page.autofill_node_title':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Remplit automatiquiement le champs Titre des noeuds pour pouvoir suprimer le champs Titre dans les affichages et formulaires.') . '</p>';
      return $output;

    default:

  }
}

/**
 * Implements hook_entity_presave().
 */
function autofill_node_title_entity_presave(EntityInterface $entity) {   //Action avant de sauvegarder un noeud
  if (!$entity instanceof NodeInterface) {
    return;
  }

  //vardump($entity->bundle());  // Nom du type de contenu
  
  //kint($entity->bundle());  // Nom du type de contenu
  if ($entity->getTitle() == NULL) {
    autofill_node_title_apply_pattern($entity);
  }
  elseif (autofill_node_title_should_update_title($entity)) {
    autofill_node_title_apply_pattern($entity);
  }

  if ($entity->bundle() =="message_du_forum" && $entity->getTitle()==NULL) {    // pour un message du forum sans titre
    $entity->setTitle("Message ".date("Y-m-d H:i:s"));    // on ajoute un titre unique (ou presque)
  }
  if ($entity->bundle() =="caci" && $entity->getTitle()==NULL) {    // pour une entité CACI sans titre
    $user=\Drupal\user\Entity\User::load($entity->field_membre->target_id); //get user by ID
    $entity->setTitle("CACI de ".$user->field_prenom->value." ".$user->field_nom->value." du ".$entity->field_date_du_caci->value); // on ajoute un titre
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for node_type_form.
 */
function autofill_node_title_form_node_type_form_alter(array &$form, FormStateInterface $form_state) {
  /** @var \Drupal\node\Entity\NodeType $type */
  $type = $form_state->getFormObject()->getEntity();

  $form['autofill_node_title'] = [
    '#type' => 'details',
    '#title' => t('Remplissage automatique du titre'),
    '#group' => 'additional_settings',
    '#tree' => TRUE,
  ];

  $form['autofill_node_title']['enabled'] = [
    '#type' => 'checkbox',
    '#title' => t('Remplissage automatique du titre'),
    '#default_value' => $type->getThirdPartySetting('autofill_node_title', 'enabled', FALSE),
  ];

  $form['autofill_node_title']['pattern'] = [
    '#type' => 'textfield',
    '#title' => t('Motif de remplissage'),
    '#default_value' => $type->getThirdPartySetting('autofill_node_title', 'pattern', ''),
    '#description' => t('Utilisez les variables disponibles ci-dessous.'),
    '#states' => [
      'visible' => [
        ':input[name="autofill_node_title[enabled]"]' => ['checked' => TRUE],
      ],
    ],
  ];

  $form['autofill_node_title']['available_variables'] = [
    '#type' => 'item',
    '#title' => t('Variables disponibles'),
    '#states' => [
      'visible' => [
        ':input[name="autofill_node_title[enabled]"]' => ['checked' => TRUE],
      ],
    ],
    'variables' => [
      '#theme' => 'item_list',
      '#items' => autofill_node_title_get_available_variables($type),
    ],
  ];

  $form['autofill_node_title']['update'] = [
    '#type' => 'checkbox',
    '#title' => t('Mettre à jour'),
    '#description' => t('Met à jour le titre du noeud si les champs utilisés par le motif sont modifiés.'),
    '#default_value' => $type->getThirdPartySetting('autofill_node_title', 'update', FALSE),
    '#states' => [
      'enabled' => [
        ':input[name="autofill_node_title[enabled]"]' => ['checked' => TRUE],
      ],
      'visible' => [
        ':input[name="autofill_node_title[enabled]"]' => ['checked' => TRUE],
      ],
    ],
  ];

  $form['#entity_builders'][] = 'autofill_node_title_node_type_builder';
}

/**
 * Returns the available pattern variables for a node type.
 */
function autofill_node_title_get_available_variables(NodeType $type) {
  $variables = [
    t('@variable : @label', [
      '@variable' => '[datecode]',
      '@label' => t('Date et heure courantes'),
    ]),
  ];

  if (!$type->id()) {
    $variables[] = t('Les variables des champs seront disponibles après l\'enregistrement du type de contenu.');
    return $variables;
  }

  $field_configs = \Drupal::entityTypeManager()
    ->getStorage('field_config')
    ->loadByProperties([
      'entity_type' => 'node',
      'bundle' => $type->id(),
    ]);

  if (empty($field_configs)) {
    return $variables;
  }

  uasort($field_configs, function ($a, $b) {
    return strnatcasecmp($a->label(), $b->label());
  });

  foreach ($field_configs as $field_config) {
    $variables[] = t('@variable : @label', [
      '@variable' => '[' . $field_config->getName() . ']',
      '@label' => $field_config->label(),
    ]);
  }

  return $variables;
}

/**
 * Entity builder for the node type form.
 */
function autofill_node_title_node_type_builder($entity_type, NodeType $type, array &$form, FormStateInterface $form_state) {
  $settings = $form_state->getValue('autofill_node_title') ?? [];
  $enabled = !empty($settings['enabled']);
  $type->setThirdPartySetting('autofill_node_title', 'enabled', $enabled);
  $type->setThirdPartySetting('autofill_node_title', 'pattern', trim($settings['pattern'] ?? ''));
  $type->setThirdPartySetting('autofill_node_title', 'update', $enabled && !empty($settings['update']));
}

/**
 * Determines whether an existing node title should be refreshed.
 */
function autofill_node_title_should_update_title(NodeInterface $node) {
  if ($node->isNew() || empty($node->original) || !$node->original instanceof NodeInterface) {
    return FALSE;
  }

  $type = NodeType::load($node->bundle());
  if (!$type || !$type->getThirdPartySetting('autofill_node_title', 'enabled', FALSE) || !$type->getThirdPartySetting('autofill_node_title', 'update', FALSE)) {
    return FALSE;
  }

  $pattern = $type->getThirdPartySetting('autofill_node_title', 'pattern', '');
  if ($pattern === '') {
    return FALSE;
  }

  foreach (autofill_node_title_get_pattern_fields($pattern) as $field_name) {
    if ($node->hasField($field_name) && $node->original->hasField($field_name) && $node->get($field_name)->getValue() !== $node->original->get($field_name)->getValue()) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Applies the configured title pattern to a node.
 */
function autofill_node_title_apply_pattern(NodeInterface $node) {
  $type = NodeType::load($node->bundle());
  if (!$type || !$type->getThirdPartySetting('autofill_node_title', 'enabled', FALSE)) {
    return;
  }

  $pattern = $type->getThirdPartySetting('autofill_node_title', 'pattern', '');
  if ($pattern === '') {
    return;
  }

  $title = preg_replace_callback('/\[([a-zA-Z0-9_:]+)\]/', function (array $matches) use ($node) {
    return autofill_node_title_get_replacement($node, $matches[1]);
  }, $pattern);

  $title = trim(preg_replace('/\s+/', ' ', $title));
  if ($title !== '') {
    $node->setTitle($title);
  }
}

/**
 * Returns the field names used in a title pattern.
 */
function autofill_node_title_get_pattern_fields($pattern) {
  preg_match_all('/\[([a-zA-Z0-9_:]+)\]/', $pattern, $matches);

  $fields = [];
  foreach ($matches[1] as $token) {
    if (strpos($token, 'node:') === 0) {
      $token = substr($token, 5);
    }
    $fields[] = $token;
  }

  return array_unique($fields);
}

/**
 * Returns the replacement value for a pattern token.
 */
function autofill_node_title_get_replacement(NodeInterface $node, $token) {
  if ($token === 'datecode') {
    return \Drupal::service('date.formatter')->format(\Drupal::time()->getRequestTime(), 'custom', 'YmdHis');
  }

  $field_name = $token;
  if (strpos($token, 'node:') === 0) {
    $field_name = substr($token, 5);
  }

  if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
    return '';
  }

  $values = [];
  foreach ($node->get($field_name) as $item) {
    if (isset($item->entity) && $item->entity) {
      $values[] = $item->entity->label();
    }
    elseif (isset($item->value) && $item->value !== '') {
      $values[] = $item->value;
    }
    else {
      $item_values = array_filter($item->toArray(), 'is_scalar');
      $item_values = array_filter($item_values, function ($value) {
        return $value !== '' && $value !== NULL;
      });
      if (!empty($item_values)) {
        $values[] = implode(' ', $item_values);
      }
    }
  }

  return implode(', ', $values);
}
